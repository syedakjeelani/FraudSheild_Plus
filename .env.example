# Copy to .env (read by docker compose; for local runs export these in your shell).

# Language model: offline (templates, default) | ollama (local open model) | anthropic (Claude API)
FRAUDSHIELD_LLM_PROVIDER=offline
FRAUDSHIELD_LLM_MODEL=
# Case data is only sent to an external API when this is true (it is pseudonymised first).
FRAUDSHIELD_ALLOW_EXTERNAL_LLM=false
ANTHROPIC_API_KEY=

# API authentication (keep false only on your own machine)
FRAUDSHIELD_AUTH_ENABLED=false
# key:role pairs, roles: analyst | supervisor
FRAUDSHIELD_API_KEYS=

# Optional Neo4j for LLM-written Cypher queries
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
